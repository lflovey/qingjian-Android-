<?xml version="1.0" encoding="utf-8"?>
<!--
  ★ v0.8 光标平移条「>>>」右移图标（VectorDrawable，24dp 基准）。

  形状：**三道等距右尖括号叠排**，形如 »›，为 [ic_cursor_triple_left] 的水平镜像。

  几何（视口 24×24，左右对称）：
     第 1 道（最左）：开口 x=3.0，尖端 x=8.5  →  M3,5.5 L8.5,12 L3,18.5
     第 2 道（居中）  ：开口 x=9.0，尖端 x=14.5 →  M9,5.5 L14.5,12 L9,18.5
     第 3 道（最右）  ：开口 x=15.0，尖端 x=20.5 → M15,5.5 L20.5,12 L15,18.5

  着色：由布局 / 代码 android:tint 指定 @color/cursor_shift_key_text(#37474F)。
  ★ 不依赖字体，真机比例恒定。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 第 1 道（最左） -->
    <path
        android:pathData="M3,5.5 L8.5,12 L3,18.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- 第 2 道（居中） -->
    <path
        android:pathData="M9,5.5 L14.5,12 L9,18.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- 第 3 道（最右） -->
    <path
        android:pathData="M15,5.5 L20.5,12 L15,18.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
