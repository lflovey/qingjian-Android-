<?xml version="1.0" encoding="utf-8"?>
<!--
  ★ v0.6 输入方式卡片背景（深色主题，selector 四态）。

  优先级从上到下（Android selector 首个匹配项生效）：
    1. state_pressed        → 按下时蓝底（协调值 #2A4A7A）
    2. state_selected       → 当前输入方式：规格蓝底 #1A73E8（高亮）
    3. state_enabled=false  → 置灰卡片：规格 #222222 底 + 无描边
    4. 默认                 → 可用且未选中：规格卡底 #2C2C2C + 协调描边 #3A3A3A

  ★ 关键：`state_selected` 用 `selected` 属性表达「当前方式」，卡片 View 通过
    `isSelected = true` 置位；`state_enabled=false` 表达「不可用（置灰）」，
    卡片通过 `isEnabled = false` 置位。二者互斥、语义清晰。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/mode_card_pressed" />
            <corners android:radius="@dimen/mode_card_radius" />
            <stroke android:width="1dp" android:color="@color/mode_card_current_stroke" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/mode_card_current_bg" />
            <corners android:radius="@dimen/mode_card_radius" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/mode_card_disabled_bg" />
            <corners android:radius="@dimen/mode_card_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mode_card_bg" />
            <corners android:radius="@dimen/mode_card_radius" />
            <stroke android:width="1dp" android:color="@color/mode_card_stroke" />
        </shape>
    </item>
</selector>
