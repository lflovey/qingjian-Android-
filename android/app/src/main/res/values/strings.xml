    <!--
      ★ v1.0 语音输入状态栏（浅色）文案。
      波纹指示器为自定义 View（非文字），故无对应字符串；
      「...」按钮为字符，不上 res（非本地化语义文案）。
      ★ Toast 文案按需求原文逐字落地（权限/不支持/错误/停止/更多设置）。
    -->
    <!-- 中间状态文字（★ v1.11：按住说话 —— 旧「倾听中，点击结束」的「点击结束」语义已死） -->
    <string name="voice_listening_hint">请说话，松开结束</string>
    <!-- 可点区域（波纹 + 文字）无障碍描述（★ v1.11 QA：改中性文案——倾听态点击=结束、
         加载/错误态点击=取消，单一定向描述会与 DECODING/ERROR 态的实际动作错配） -->
    <string name="voice_stop_desc">结束或取消语音输入</string>
    <!-- 右侧「...」按钮无障碍描述 -->
    <string name="voice_more_desc">更多语音设置</string>
    <!-- 输入时 Toast 提示 -->
    <string name="voice_need_audio_permission">请去系统设置中给青简输入法开启录音权限</string>
    <string name="voice_more_placeholder">更多语音设置暂未开放</string>
    <string name="voice_error_audio">录音出错，请重试</string>
    <!--
      ★ v1.9 纯离线（sherpa-onnx + SenseVoice-Small）新增文案。
    -->
    <string name="voice_error_default">语音识别出错，请重试</string>
    <!-- ★ v1.12：录音通道中断（AudioRecord.read 连续异常，非用户松手）→ 明确错误收口文案 -->
    <string name="voice_error_capture">录音通道中断，请重试</string>
    <!-- 需求 2：完整性校验失败（文件缺失/长度不符，脏文件已删） -->
    <string name="voice_model_corrupt">模型文件损坏，请重新安装或推送模型</string>
    <!-- 需求 3：IO 失败（多为存储空间不足） -->
    <string name="voice_model_io_error">模型准备失败，请清理存储空间后重试</string>
    <!-- 模型准备中（首启拷贝 228MB 需数秒） -->
    <string name="voice_model_preparing">正在准备离线模型，请稍候…</string>
    <!-- ★ v1.11 按住说话：松开时模型仍未就绪（本次未录到音频）→ 提示稍后再试 -->
    <string name="voice_hold_model_preparing">模型准备中，请稍后再试</string>
    <!-- 识别无有效语音 -->
    <string name="voice_offline_empty">未听到声音，请重试</string>
    <!-- 离线引擎不可用（native 库加载失败等） -->
    <string name="voice_offline_unavailable">离线语音引擎不可用，请重新安装</string>

    <!--
      ★ v1.10 四态状态条新增文案（同一面板按真实状态切换）。
        · ① 加载态：带百分比（进度回调驱动）/ 无百分比（不确定态）
        · ③ 识别态：VAD 已断句、ASR 推理中
        · ④ 错误/空结果：复用既有 voice_offline_empty / voice_error_default 等，不在此新增。
    -->
    <!-- ① 加载态 · 带百分比（%1$d 为 0..100 整数；%% 输出字面 %） -->
    <string name="voice_model_loading_percent">正在准备离线模型 %1$d%%</string>
    <!-- ① 加载态 · 百分比未知时的无参版 -->
    <string name="voice_model_loading">正在准备离线模型…</string>
    <!-- ③ 识别态 -->
    <string name="voice_decoding_hint">识别中…</string>

    <!--
      ★ v1.3 删除键上滑清空：气泡文案（需求原文「松开清空」）。
    -->
    <string name="backspace_clear_hint">松开清空</string>
</resources>
